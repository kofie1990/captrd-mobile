{
  "expo": {
    "name": "Captrd",
    "slug": "captrd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "captrd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "live.captrd.app",
      "associatedDomains": [
        "applinks:captrd.live",
        "appclips:captrd.live"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "live.captrd.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Captrd to access your camera to take event photos.",
          "microphonePermission": "Allow Captrd to access your microphone to record event videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Captrd to access your photos to upload to the shared gallery."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ],
      [
        "react-native-app-clip",
        {
          "name": "Captrd App Clip"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "CaptrdLiveActivity"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e555997d-b0b1-41e7-b1af-fd70f516aeb0"
      }
    }
  }
}
