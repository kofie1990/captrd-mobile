{
  "expo": {
    "name": "Captrd",
    "slug": "captrd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "captrd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "7TXV7D2XYZ",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "bundleIdentifier": "live.captrd.app",
      "entitlements": {
        "com.apple.developer.associated-appclip-app-identifiers": [
          "$(AppIdentifierPrefix)live.captrd.app.appclip"
        ]
      },
      "associatedDomains": [
        "applinks:captrd.live",
        "appclips:captrd.live",
        "applinks:www.captrd.live",
        "appclips:www.captrd.live"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "Allow Captrd to access your camera to take event photos.",
        "NSMicrophoneUsageDescription": "Allow Captrd to access your microphone to record event videos.",
        "NSPhotoLibraryUsageDescription": "Allow Captrd to access your photos to upload to the shared gallery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "live.captrd.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Captrd to access your camera to take event photos.",
          "microphonePermission": "Allow Captrd to access your microphone to record event videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Captrd to access your photos to upload to the shared gallery."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.live.captrd.app",
          "widgets": [
            {
              "name": "CaptrdLiveActivity",
              "displayName": "Captrd Roll",
              "description": "Track your photo roll in real-time",
              "supportedFamilies": [
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-share",
        {
          "android": {}
        }
      ],
      "./plugins/withWidgetLogo.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "live.captrd.app.appclip",
                  "targetName": "CaptrdAppClip",
                  "entitlements": {
                    "com.apple.developer.parent-application-identifiers": [
                      "$(AppIdentifierPrefix)live.captrd.app"
                    ],
                    "com.apple.developer.on-demand-install-capable": true,
                    "com.apple.developer.associated-domains": [
                      "applinks:captrd.live",
                      "appclips:captrd.live",
                      "applinks:www.captrd.live",
                      "appclips:www.captrd.live"
                    ],
                    "com.apple.security.application-groups": [
                      "group.live.captrd.app"
                    ]
                  }
                },
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "live.captrd.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.live.captrd.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "06d18684-1d29-4ca3-ae3e-a131b5d397eb"
      }
    },
    "owner": "jacksonburns-team"
  }
}
